<task name="grasp_bottle_place_bowl">
  <description>Use the left arm to grasp the bottle and place it into the pink bowl.</description>
  <task_objects>
    <object>bottle</object>
    <object>pink bowl</object>
  </task_objects>
  <substages>
    <substage>1. Move the left arm to approach and align with the bottle.</substage>
    <substage>2. Grasp the bottle.</substage>
    <substage>3. Move the left arm to align with the pink bowl.</substage>
    <substage>4. Release the gripper to place the bottle into the pink bowl.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
