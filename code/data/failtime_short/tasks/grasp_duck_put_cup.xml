<task name="grasp_duck_put_cup">
  <description>Use the right arm to grasp the orange duck and place it on the cup.</description>
  <task_objects>
    <object>orange duck</object>
    <object>cup</object>
  </task_objects>
  <substages>
    <substage>1. Move the right arm to approach and align with the yellow duck.</substage>
    <substage>2. Grasp the yellow duck.</substage>
    <substage>3. Move the right arm to align with the cup.</substage>
    <substage>4. Release the gripper to place the yellow duck on the cup.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
