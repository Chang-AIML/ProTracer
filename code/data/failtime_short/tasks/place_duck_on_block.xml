<task name="place_duck_on_block">
  <description>Use the left arm to place the green duck on top of the green block.</description>
  <task_objects>
    <object>green duck</object>
    <object>green block</object>
  </task_objects>
  <substages>
    <substage>1. Move the left arm to approach and align with the green duck.</substage>
    <substage>2. Grasp the green duck.</substage>
    <substage>3. Move the left arm to align with the green block.</substage>
    <substage>4. Release the gripper to place the green duck on top of the green block.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
    <predicate>stacked_on</predicate>
  </predicates>
</task>
