<task name="grasp_coke_can_put_tray">
  <description>Use the right arm to grasp the Coke can and place it on the green tray.</description>
  <task_objects>
    <object>coke can</object>
    <object>green tray</object>
  </task_objects>
  <substages>
    <substage>1. Move the right arm to approach and align with the Coke can.</substage>
    <substage>2. Grasp the Coke can.</substage>
    <substage>3. Move the right arm to align with the green tray.</substage>
    <substage>4. Release the gripper to place the Coke can on the green tray.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
