<task name="pick_cube_place_plate">
  <description>Use the left arm to pick up the blue cube and place it on the green plate.</description>
  <task_objects>
    <object>blue cube</object>
    <object>green plate</object>
  </task_objects>
  <substages>
    <substage>1. Move the left arm to approach and align with the blue cube.</substage>
    <substage>2. Grasp the blue cube.</substage>
    <substage>3. Move the left arm to align with the green plate.</substage>
    <substage>4. Release the gripper to place the blue cube on the green plate.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
