<task name="pick_bowl_on_top_shelf">
  <description>Use the left arm to pick up the pink bowl and place it on the top shelf.</description>
  <task_objects>
    <object>pink bowl</object>
    <object>top shelf</object>
  </task_objects>
  <substages>
    <substage>1. Move the left arm to approach and align with the pink bowl.</substage>
    <substage>2. Grasp the pink bowl.</substage>
    <substage>3. Move the left arm to align with the top shelf.</substage>
    <substage>4. Release the gripper to place the pink bowl on the top shelf.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
