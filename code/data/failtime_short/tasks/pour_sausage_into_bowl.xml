<task name="pour_sausage_into_bowl">
  <description>Use the right arm to pour the sausages from the plate into the pink bowl.</description>
  <task_objects>
    <object>sausage</object>
    <object>plate</object>
    <object>pink bowl</object>
  </task_objects>
  <substages>
    <substage>1. Move the right arm to approach and align with the plate.</substage>
    <substage>2. Grasp the plate with the right arm.</substage>
    <substage>3. Move the right arm to align the plate above the pink bowl.</substage>
    <substage>4. Tilt the plate to pour the sausages into the pink bowl.</substage>
    <substage>5. Release the plate.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
    <predicate>tilted_above</predicate>
    <predicate>pouring_into</predicate>
  </predicates>
</task>
