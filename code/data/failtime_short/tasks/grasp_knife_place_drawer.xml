<task name="grasp_knife_place_drawer">
  <description>Use the right arm to grasp the knife from the holder and place it in the drawer.</description>
  <task_objects>
    <object>knife</object>
    <object>holder</object>
    <object>drawer</object>
  </task_objects>
  <substages>
    <substage>1. Move the right arm to approach and align with the knife holder.</substage>
    <substage>2. Grasp the knife from the holder.</substage>
    <substage>3. Move the right arm to align with the drawer.</substage>
    <substage>4. Release the gripper to place the knife into the drawer.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
    <predicate>open</predicate>
    <predicate>closed</predicate>
    <predicate>partly_open</predicate>
  </predicates>
</task>
