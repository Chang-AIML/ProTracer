<task name="grasp_cube_place_shelf">
  <description>Use the right arm to grasp the test tube and place it upright on the shelf.</description>
  <task_objects>
    <object>test tube</object>
    <object>shelf</object>
  </task_objects>
  <substages>
    <substage>1. Move the right arm to approach and align with the test tube.</substage>
    <substage>2. Grasp the test tube.</substage>
    <substage>3. Move the right arm to align with the shelf.</substage>
    <substage>4. Release the gripper to place the test tube upright on the shelf.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
