<task name="pick_orange_block_place_pot">
  <description>Use the left arm to place the orange block into the pot.</description>
  <task_objects>
    <object>orange block</object>
    <object>pot</object>
  </task_objects>
  <substages>
    <substage>1. Move the left arm to approach and align with the orange block.</substage>
    <substage>2. Grasp the orange block.</substage>
    <substage>3. Move the left arm to align with the pot.</substage>
    <substage>4. Release the gripper to place the orange block into the pot.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
