<task name="stack_green_cup_into_purple_cup">
  <description>Use the left arm to stack the green cup into the purple cup.</description>
  <task_objects>
    <object>green cup</object>
    <object>purple cup</object>
  </task_objects>
  <substages>
    <substage>1. Move the left arm to approach and align with the green cup.</substage>
    <substage>2. Grasp the green cup.</substage>
    <substage>3. Move the left arm to align with the purple cup.</substage>
    <substage>4. Release the gripper to stack the green cup into the purple cup.</substage>
  </substages>
