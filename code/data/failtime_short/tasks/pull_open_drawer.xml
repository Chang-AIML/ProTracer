<task name="pull_open_drawer">
  <description>Use the left arm to pull open the top drawer.</description>
  <task_objects>
    <object>top drawer</object>
  </task_objects>
  <substages>
    <substage>1. Move the left arm to approach and align with the handle of the top drawer.</substage>
    <substage>2. Grasp the handle of the top drawer with the left arm.</substage>
    <substage>3. Pull the top drawer open using the left arm.</substage>
  </substages>
