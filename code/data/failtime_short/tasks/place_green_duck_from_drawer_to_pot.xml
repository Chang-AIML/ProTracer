<task name="place_green_duck_from_drawer_to_pot">
  <description>Use the right arm to pick up the green duck from the drawer and place it on the red pot.</description>
  <task_objects>
    <object>green duck</object>
    <object>drawer</object>
    <object>red pot</object>
  </task_objects>
  <substages>
    <substage>1. Move the right arm to approach and align with the green duck in the drawer.</substage>
    <substage>2. Grasp the green duck.</substage>
    <substage>3. Move the right arm to align with the red pot.</substage>
    <substage>4. Release the gripper to place the green duck on the red pot.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
    <predicate>open</predicate>
    <predicate>closed</predicate>
    <predicate>partly_open</predicate>
  </predicates>
</task>
