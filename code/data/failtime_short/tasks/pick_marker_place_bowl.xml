<task name="pick_marker_place_bowl">
  <description>Use the right arm to pick up the marker and place it into the white bowl.</description>
  <task_objects>
    <object>marker</object>
    <object>white bowl</object>
  </task_objects>
  <substages>
    <substage>1. Move the right arm to approach and align with the marker.</substage>
    <substage>2. Grasp the marker.</substage>
    <substage>3. Move the right arm to align with the white bowl.</substage>
    <substage>4. Release the gripper to place the marker into the white bowl.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
