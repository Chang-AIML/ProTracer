<task name="pick_spoon_place_rice_cooker">
  <description>Use the right arm to pick up the spoon and place it into the rice cooker.</description>
  <task_objects>
    <object>spoon</object>
    <object>rice cooker</object>
  </task_objects>
  <substages>
    <substage>1. Move the right arm to approach and align with the spoon.</substage>
    <substage>2. Grasp the spoon.</substage>
    <substage>3. Move the right arm to align with the rice cooker.</substage>
    <substage>4. Release the gripper to place the spoon into the rice cooker.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
