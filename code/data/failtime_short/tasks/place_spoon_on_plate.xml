<task name="place_spoon_on_plate">
  <description>Use the left arm to place the spoon on the purple plate.</description>
  <task_objects>
    <object>spoon</object>
    <object>purple plate</object>
  </task_objects>
  <substages>
    <substage>1. Move the left arm to approach and align with the spoon.</substage>
    <substage>2. Grasp the spoon.</substage>
    <substage>3. Move the left arm to align with the purple plate.</substage>
    <substage>4. Release the gripper to place the spoon on the purple plate.</substage>
  </substages>
  <predicates>
    <predicate>grasped</predicate>
    <predicate>contact</predicate>
    <predicate>near</predicate>
    <predicate>aligned_with</predicate>
    <predicate>inside</predicate>
    <predicate>on_top_of</predicate>
    <predicate>supports</predicate>
    <predicate>separated_from</predicate>
    <predicate>left_of</predicate>
    <predicate>right_of</predicate>
    <predicate>above</predicate>
    <predicate>below</predicate>
    <predicate>in_front_of</predicate>
    <predicate>behind</predicate>
  </predicates>
</task>
